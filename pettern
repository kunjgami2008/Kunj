<!DOCTYPE html>
<html>
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title></title>
</head>
<body>

	<script>
		var i,j;
		for(i=0;i<5;i++)
		{
		  var ans="<br>";

			for(j=1;j<=i;j++)
			{
				ans=ans+j;
				document.write(ans);
			}

			document.write("<br>");

		}

	</script>

</body>
</html>
